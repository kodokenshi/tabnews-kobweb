{
  "name": "tabnews-kobweb",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "node gradlew.js clean --no-daemon",
    "dev": "node gradlew.js site:runDev --no-daemon",
    "dev:stop": "node gradlew.js site:stopDev --no-daemon",
    "test": "node gradlew.js site:tests --no-daemon",
    "test:verbose": "node gradlew.js site:tests -Pverbose=true --no-daemon",
    "test:full": "node gradlew.js site:runTests --no-daemon",
    "test:full:verbose": "node gradlew.js site:runTests -Pverbose=true --no-daemon",
    "services:up": "node gradlew.js site:servicesUp --no-daemon",
    "services:stop": "node gradlew.js site:servicesStop --no-daemon",
    "services:down": "node gradlew.js site:servicesDown --no-daemon",
    "server:up:detached": "node gradlew.js site:kobwebStart --no-daemon",
    "server:down": "node gradlew.js site:kobwebStop",
    "lint:style:check": "node gradlew.js site:sqllintCheck --no-daemon && node gradlew.js site:ktlintCheck --no-daemon",
    "lint:code:check": "node gradlew.js site:detekt --no-daemon",
    "prepare": "husky",
    "commit": "cz"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "secretlint": "13.0.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
